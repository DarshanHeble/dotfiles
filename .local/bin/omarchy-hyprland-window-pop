#!/usr/bin/env python3
import json
import subprocess
import sys

try:
    data = subprocess.check_output(["hyprctl", "-j", "activewindow"])
    window = json.loads(data)
except Exception:
    sys.exit(0)

if not window or "address" not in window:
    sys.exit(0)

floating = window.get("floating", False)
pinned = window.get("pinned", False)

if not floating or not pinned:
    # Pop window out: unfullscreen if active, float, resize to 1300x900, center, pin
    lua = """
    local w = hl.get_active_window()
    if w then
        if w.fullscreen ~= 0 then
            hl.dispatch(hl.dsp.window.fullscreen(0))
        end
        hl.dispatch(hl.dsp.window.float({ state = true }))
        hl.dispatch(hl.dsp.window.resize({ x = 1300, y = 900 }))
        hl.dispatch(hl.dsp.window.center())
        hl.dispatch(hl.dsp.window.pin())
    end
    """
    subprocess.run(["hyprctl", "eval", lua], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
else:
    # Pop window back into tiling: unpin, unfloat
    lua = """
    local w = hl.get_active_window()
    if w then
        hl.dispatch(hl.dsp.window.pin())
        hl.dispatch(hl.dsp.window.float({ state = false }))
    end
    """
    subprocess.run(["hyprctl", "eval", lua], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
