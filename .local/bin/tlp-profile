#!/bin/bash
PROFILE="$1"

case "$PROFILE" in
    "power-saver"|"saver"|"low")
        for cpu in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
            [ -f "$cpu" ] && echo "power" > "$cpu" 2>/dev/null
        done
        ;;
    "performance"|"perf"|"high")
        for cpu in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
            [ -f "$cpu" ] && echo "performance" > "$cpu" 2>/dev/null
        done
        ;;
    "balanced"|"balance"|"default"|*)
        for cpu in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
            [ -f "$cpu" ] && echo "balance_power" > "$cpu" 2>/dev/null
        done
        ;;
esac
