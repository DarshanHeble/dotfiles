#!/usr/bin/env python3
import subprocess
import re
import sys
import os

def main():
    args = sys.argv[1:]
    arg_str = " ".join(args)

    # If NetworkManager daemon is actually active, forward directly to real nmcli
    try:
        if subprocess.run(["systemctl", "is-active", "--quiet", "NetworkManager"]).returncode == 0:
            os.execv("/usr/bin/nmcli", ["/usr/bin/nmcli"] + args)
    except Exception:
        pass

    # 1. Device status
    # nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status
    if "device" in args and "status" in args:
        wlan_state = "disconnected"
        wlan_conn = ""
        try:
            st = subprocess.check_output(["iwctl", "station", "wlan0", "show"], stderr=subprocess.DEVNULL).decode()
            if "connected" in st:
                wlan_state = "connected"
                m = re.search(r"Connected network\s+(.+)", st)
                if m:
                    wlan_conn = m.group(1).strip()
            elif "connecting" in st:
                wlan_state = "connecting"
                m = re.search(r"Connected network\s+(.+)", st)
                if m:
                    wlan_conn = m.group(1).strip()
        except Exception:
            pass

        if "-t" in args:
            print(f"eno1:ethernet:unavailable:")
            print(f"wlan0:wifi:{wlan_state}:{wlan_conn}")
            print(f"lo:loopback:unmanaged:")
        else:
            print("DEVICE  TYPE      STATE        CONNECTION")
            print(f"eno1    ethernet  unavailable  --")
            print(f"wlan0   wifi      {wlan_state}    {wlan_conn}")
            print(f"lo      loopback  unmanaged    --")
        return

    # 2. Radio status
    # nmcli radio wifi
    if "radio" in args and "wifi" in args:
        print("enabled")
        return

    # 3. Connection list
    if "connection" in args and ("show" in args or len(args) == 1):
        cur_ssid = ""
        try:
            st = subprocess.check_output(["iwctl", "station", "wlan0", "show"], stderr=subprocess.DEVNULL).decode()
            if "connected" in st:
                m = re.search(r"Connected network\s+(.+)", st)
                if m:
                    cur_ssid = m.group(1).strip()
        except Exception:
            pass
        if cur_ssid:
            print(f"{cur_ssid}:802-11-wireless")
        return

    # 4. Wi-Fi networks detail list
    # nmcli -g ACTIVE,SIGNAL,FREQ,SSID,BSSID,SECURITY d w
    if ("d" in args and "w" in args) or ("device" in args and "wifi" in args):
        cur_ssid = ""
        cur_bssid = "6a:f9:c4:70:b4:e6"
        cur_freq = "2432"
        sig = 100
        try:
            st = subprocess.check_output(["iwctl", "station", "wlan0", "show"], stderr=subprocess.DEVNULL).decode()
            if "connected" in st:
                m = re.search(r"Connected network\s+(.+)", st)
                if m:
                    cur_ssid = m.group(1).strip()
                bm = re.search(r"ConnectedBss\s+([0-9a-fA-F:]+)", st)
                if bm:
                    cur_bssid = bm.group(1).strip()
                fm = re.search(r"Frequency\s+(\d+)", st)
                if fm:
                    cur_freq = fm.group(1).strip()
                rm = re.search(r"RSSI\s+(-\d+)", st)
                if rm:
                    rssi = int(rm.group(1))
                    sig = max(0, min(100, int(2 * (rssi + 100))))
        except Exception:
            pass

        if cur_ssid:
            print(f"yes:{sig}:{cur_freq}:{cur_ssid}:{cur_bssid}:WPA2")

        try:
            out = subprocess.check_output(["iwctl", "station", "wlan0", "get-networks"], stderr=subprocess.DEVNULL).decode()
            out = re.sub(r"\x1B\[[0-9;]*[a-zA-Z]", "", out)
            for line in out.splitlines()[4:]:
                line = line.strip().lstrip(">").strip()
                if not line:
                    continue
                parts = re.split(r"\s{2,}", line)
                if parts and parts[0] != "Network name":
                    name = parts[0]
                    if name != cur_ssid:
                        print(f"no:70:2412:{name}::WPA2")
        except Exception:
            pass
        return

    # 5. Connect command
    if "device" in args and "wifi" in args and "connect" in args:
        idx = args.index("connect")
        if idx + 1 < len(args):
            ssid = args[idx + 1]
            pwd = ""
            if "password" in args:
                p_idx = args.index("password")
                if p_idx + 1 < len(args):
                    pwd = args[p_idx + 1]
            cmd = ["iwctl", "station", "wlan0", "connect", ssid]
            if pwd:
                cmd.extend(["--passphrase", pwd])
            res = subprocess.run(cmd)
            sys.exit(res.returncode)

    # 6. Monitor
    if "monitor" in args:
        import time
        while True:
            time.sleep(10)

    # Fallback to real nmcli for any other options
    try:
        os.execv("/usr/bin/nmcli", ["/usr/bin/nmcli"] + args)
    except Exception:
        sys.exit(0)

if __name__ == "__main__":
    main()
